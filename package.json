{
  "name": "edge-spec",
  "version": "0.1.0",
  "private": true,
  "description": "Find untested code, generate tests with the model you choose, and open a pull request.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @edge-spec/web dev",
    "dev:worker": "bun run --filter @edge-spec/worker dev",
    "cli": "bun apps/cli/src/index.ts",
    "mcp": "bun apps/mcp/src/index.ts",
    "docs:dev": "bun run --filter @edge-spec/docs dev",
    "docs:build": "bun run --filter @edge-spec/docs build",
    "docs:preview": "bun run --filter @edge-spec/docs preview",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "bun run --filter @edge-spec/web build",
    "build:worker": "bun run --filter @edge-spec/worker build",
    "preview": "bun run --filter @edge-spec/web preview",
    "deploy": "bun run --filter @edge-spec/worker deploy",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "oxlint . --deny-warnings",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
