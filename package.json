{
  "name": "edge-spec",
  "version": "0.1.0",
  "private": true,
  "description": "Find untested code, generate tests with the model you choose, and open a pull request.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples"
  ],
  "scripts": {
    "dev": "bun run --filter @edge-spec/web dev",
    "dev:worker": "bun run db:migrate:local && bun run --filter @edge-spec/worker dev",
    "db:migrate": "wrangler d1 migrations apply edge-spec-runs --remote",
    "db:migrate:local": "wrangler d1 migrations apply edge-spec-runs --local",
    "cli": "bun packages/cli/src/index.ts",
    "mcp": "bun packages/mcp/src/index.ts",
    "sandbox": "bun run --filter @edge-spec/sandbox start",
    "dev:sandbox-worker": "bun run --filter @edge-spec/sandbox-worker dev",
    "deploy:sandbox-worker": "bun run --filter @edge-spec/sandbox-worker deploy",
    "docs:dev": "bun run --filter @edge-spec/docs dev",
    "docs:build": "bun run --filter @edge-spec/docs build",
    "docs:preview": "bun run --filter @edge-spec/docs preview",
    "eval": "bun evals/run.ts",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "bun run --filter @edge-spec/web build",
    "build:worker": "bun run --filter @edge-spec/worker build",
    "preview": "bun run --filter @edge-spec/web preview",
    "deploy": "bun run --filter @edge-spec/worker deploy",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "oxlint . --deny-warnings",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
