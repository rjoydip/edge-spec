{
  "name": "edge-spec",
  "version": "0.1.0",
  "private": true,
  "description": "Find untested code, generate tests with the model you choose, and open a pull request.",
  "type": "module",
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "evals",
    "examples",
    "infra/*"
  ],
  "scripts": {
    "dev": "bun run --filter @edge-spec/web dev",
    "dev:all": "bun run scripts/dev.ts",
    "dev:worker": "bun run build:worker && bun run scripts/dev-worker.ts",
    "cli": "bun packages/cli/src/index.ts",
    "mcp": "bun packages/mcp/src/index.ts",
    "sandbox": "bun run --filter @edge-spec/sandbox start",
    "serve": "bun apps/server/src/index.ts",
    "start:node": "bun apps/server/src/index.ts",
    "dev:node": "bun --watch apps/server/src/index.ts",
    "migrate": "bun packages/runtime/scripts/migrate.ts",
    "docs:dev": "bun run --filter @edge-spec/docs dev",
    "docs:build": "bun run --filter @edge-spec/docs build",
    "docs:deploy": "bun run docs:build && bunx wrangler pages deploy apps/docs/.vitepress/dist --project-name edge-spec-docs --branch main",
    "docs:preview": "bun run --filter @edge-spec/docs preview",
    "eval": "bun evals/src/run.ts",
    "migrate:hashes": "bun scripts/fix-migration-hashes.ts",
    "alchemy": "bun run --cwd infra/cloudflare alchemy",
    "deploy:stage": "bun run build && bun run --cwd infra/cloudflare deploy --stage",
    "test:stack": "bun run test:cloudflare && bun run test:aws && bun run test:vercel && bun run test:fly && bun run test:railway && bun run test:docker && bun run test:kubernetes",
    "test:cloudflare": "bun run build && bun run --cwd infra/cloudflare test",
    "test:aws": "bun run --cwd infra/aws test",
    "test:vercel": "bun run --cwd infra/vercel test",
    "test:fly": "bun run --cwd infra/fly test",
    "test:railway": "bun run --cwd infra/railway test",
    "test:docker": "bun run --cwd infra/docker test",
    "test:kubernetes": "bun run --cwd infra/kubernetes test",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "bun run --filter @edge-spec/web build",
    "build:worker": "bun run --filter @edge-spec/worker build",
    "preview": "bun run --filter @edge-spec/web preview",
    "deploy": "bun run build && bun run --cwd infra/cloudflare deploy --stage prod",
    "deploy:aws": "bun run --cwd infra/aws deploy --stage prod",
    "deploy:vercel": "bun run --cwd infra/vercel deploy --stage prod",
    "deploy:fly": "bun run --cwd infra/fly deploy --stage prod",
    "deploy:railway": "bun run --cwd infra/railway deploy --stage prod",
    "deploy:docker": "bun run --cwd infra/docker deploy --stage prod",
    "deploy:kubernetes": "bun run --cwd infra/kubernetes deploy --stage prod",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "oxlint . --deny-warnings",
    "format": "bun fmt --print-width=100 --object-wrap=preserve .",
    "format:check": "bun fmt --check --print-width=100 --object-wrap=preserve .",
    "test": "bun test",
    "verify": "bun run format:check && bun run lint && bun check . && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
