{
  "name": "edge-spec",
  "version": "0.1.0",
  "private": true,
  "description": "Find untested code, generate tests with the model you choose, and open a pull request.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 5174",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "vite build",
    "build:worker": "vite build --config config/vite.worker.ts",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@vortexlabs/kirari": "^1.1.0",
    "@vortexlabs/kirari-react": "^1.1.0",
    "clsx": "^2.1.1",
    "hono": "^4.9.6",
    "lucide-react": "^1.58.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitepress": "^1.6.4",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3"
}
