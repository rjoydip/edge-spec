# Fly target (`bun run deploy:fly`).
# Alchemy uses FLY_API_TOKEN for the provider; Docker uses it to push the image
# to registry.fly.io.
FLY_API_TOKEN=
FLY_REGION=iad
EDGESPEC_IMAGE_TAG=latest

# Runtime configuration is not baked into the image. Set it on the App:
#   fly secrets set --app edge-spec EDGESPEC_DB_URL=postgres://... ...
# See apps/docs/deployment.md §8 for the full list.

# Accounts (Better Auth). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Email sender for verification and password reset (Resend).
# EMAIL_API_KEY=
# EMAIL_FROM=
# Observability: consola (default), otlp, sentry, axiom or none.
# EDGESPEC_OBSERVABILITY=consola
# EDGESPEC_LOG_LEVEL=info
# EDGESPEC_SERVICE_NAME=edgespec
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Bun server only: HOST=127.0.0.1 prints the local listening line.
# HOST=0.0.0.0
