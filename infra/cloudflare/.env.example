# Cloudflare automation secrets for `bun run deploy` and `alchemy dev`.
#
# Copy to `infra/cloudflare/.env` (git-ignored) and fill in. Alchemy loads that
# file from this directory automatically; nothing here is needed for
# dashboard-only use. Never add visitor keys or tokens: those travel as request
# headers.

# GitHub App — preferred for multiple repositories.
GH_APP_ID=
# PKCS#8 PEM. Double-quoted multi-line values are supported by the dotenv loader.
GH_APP_PRIVATE_KEY=

# Verifies x-hub-signature-256 on POST /webhook. Recommended; without it any
# caller can create Workflow runs.
GH_WEBHOOK_SECRET=

# PAT fallback for webhook runs when no App is configured.
GH_TOKEN=

# Optional drift notifications. The secret is sent as x-edgespec-secret.
DRIFT_ALERT_WEBHOOK_URL=
DRIFT_ALERT_WEBHOOK_SECRET=
