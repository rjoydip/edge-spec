# AWS target. Copy to `infra/aws/.env` (git-ignored) or use a configured
# `alchemy profile`. Standard AWS credentials/profile are enough.
AWS_PROFILE=default
AWS_REGION=us-east-1

# The app reads the bucket this stack creates:
# EDGESPEC_PROVIDER=aws
# EDGESPEC_BLOB=s3
# EDGESPEC_BLOB_BUCKET=edge-spec-artifacts
# EDGESPEC_BLOB_REGION=us-east-1

# Accounts (Better Auth). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Email sender for verification and password reset (Resend).
# EMAIL_API_KEY=
# EMAIL_FROM=
# Observability: consola (default), otlp, sentry, axiom or none.
# EDGESPEC_OBSERVABILITY=consola
# EDGESPEC_LOG_LEVEL=info
# EDGESPEC_SERVICE_NAME=edgespec
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Bun server only: HOST=127.0.0.1 prints the local listening line.
# HOST=0.0.0.0
