# Vercel target. Copy to `infra/vercel/.env` (git-ignored) or export these.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# The runtime reads these at request time (see apps/docs/deployment.md §8).
# EDGESPEC_PROVIDER=vercel
# EDGESPEC_DB_URL=postgres://…
# EDGESPEC_BLOB_ENDPOINT=https://…
# EDGESPEC_BLOB_BUCKET=…
# EDGESPEC_BLOB_REGION=…
# EDGESPEC_BLOB_ACCESS_KEY_ID=…
# EDGESPEC_BLOB_SECRET_ACCESS_KEY=…
# EDGESPEC_JOB_URL=https://…
# EDGESPEC_JOB_KEY=…
# EDGESPEC_REDIS_URL=…
# EDGESPEC_REDIS_TOKEN=…
# CRON_SECRET=…

# Accounts (Better Auth). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Email sender for verification and password reset (Resend).
# EMAIL_API_KEY=
# EMAIL_FROM=
# Observability: consola (default), otlp, sentry, axiom or none.
# EDGESPEC_OBSERVABILITY=consola
# EDGESPEC_LOG_LEVEL=info
# EDGESPEC_SERVICE_NAME=edgespec
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Bun server only: HOST=127.0.0.1 prints the local listening line.
# HOST=0.0.0.0
