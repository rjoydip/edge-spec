# Local Docker target (`bun run deploy:docker`).
# `infra/docker/.env` is mounted as the container env file when present.
# Every capability is optional; without it the routes answer enabled: false.
EDGESPEC_PROVIDER=node
EDGESPEC_DB_URL=postgres://postgres:postgres@host.docker.internal:5432/edge_spec
# EDGESPEC_BLOB_ENDPOINT=
# EDGESPEC_BLOB_BUCKET=
# EDGESPEC_BLOB_REGION=
# EDGESPEC_BLOB_ACCESS_KEY_ID=
# EDGESPEC_BLOB_SECRET_ACCESS_KEY=
# EDGESPEC_JOB_URL=
# EDGESPEC_JOB_KEY=
# EDGESPEC_REDIS_URL=
# EDGESPEC_REDIS_TOKEN=
# CRON_SECRET=

# Accounts (Better Auth). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Plain HTTP on localhost only (Docker/kind): set to 1 so the session cookie is stored.
# EDGESPEC_INSECURE_COOKIES=1
# Email sender for verification and password reset (Resend).
# EMAIL_API_KEY=
# EMAIL_FROM=
# Observability: consola (default), otlp, sentry, axiom or none.
# EDGESPEC_OBSERVABILITY=consola
# EDGESPEC_LOG_LEVEL=info
# EDGESPEC_SERVICE_NAME=edgespec
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Bun server only: HOST=127.0.0.1 prints the local listening line.
# HOST=0.0.0.0
