# Local Docker target (`bun run deploy:docker`).
# `infra/docker/.env` is mounted as the container env file when present.
# Every capability is optional; without it the routes answer enabled: false.
EDGESPEC_PROVIDER=node
EDGESPEC_DB_URL=postgres://postgres:postgres@host.docker.internal:5432/edge_spec
