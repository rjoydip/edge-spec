# Kubernetes target (`bun run deploy:kubernetes`).
# Pin a kubeconfig context and the registry the nodes pull built images from.
KUBE_CONTEXT=
KUBE_REGISTRY=

# ALCHEMY_DEV=1 creates a local kind cluster and its built-in registry instead.
# ALCHEMY_DEV=1

# Runtime configuration comes from the cluster (ConfigMap/Secret). See
# apps/docs/deployment.md §8 for the full list.
