# Kubernetes target (`bun run deploy:kubernetes`).
# Pin a kubeconfig context and the registry the nodes pull built images from.
KUBE_CONTEXT=
KUBE_REGISTRY=

# ALCHEMY_DEV=1 creates a local kind cluster and its built-in registry instead.
# ALCHEMY_DEV=1

# Runtime configuration comes from the cluster (ConfigMap/Secret). See
# apps/docs/deployment.md §8 for the full list.

# Accounts (Better Auth). Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Plain HTTP on localhost only (Docker/kind): set to 1 so the session cookie is stored.
# EDGESPEC_INSECURE_COOKIES=1
# Email sender for verification and password reset (Resend).
# EMAIL_API_KEY=
# EMAIL_FROM=
# Observability: consola (default), otlp, sentry, axiom or none.
# EDGESPEC_OBSERVABILITY=consola
# EDGESPEC_LOG_LEVEL=info
# EDGESPEC_SERVICE_NAME=edgespec
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Bun server only: HOST=127.0.0.1 prints the local listening line.
# HOST=0.0.0.0
